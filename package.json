{
  "name": "api-petshop",
  "version": "1.0.0",
  "description": "API REST para gestão de petshop (agendamento de banhos, pets, estoque e notificações)",
  "type": "module",
  "main": "src/interfaces/http/server.js",
  "scripts": {
    "start": "node src/interfaces/http/server.js",
    "dev": "node --watch src/interfaces/http/server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "prisma:generate": "prisma generate --schema=src/infrastructure/database/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=src/infrastructure/database/prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema=src/infrastructure/database/prisma/schema.prisma",
    "prisma:seed": "node src/infrastructure/database/prisma/seed.js",
    "prisma:studio": "prisma studio --schema=src/infrastructure/database/prisma/schema.prisma"
  },
  "prisma": {
    "seed": "node src/infrastructure/database/prisma/seed.js"
  },
  "keywords": [
    "petshop",
    "api",
    "clean-architecture"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "pino-pretty": "^11.2.2",
    "prisma": "^5.20.0"
  }
}
