# Banco de dados
# Supabase: use a "Connection pooling" (porta 6543, ?pgbouncer=true) aqui — é a usada em runtime pela API.
DATABASE_URL="postgresql://usuario:senha@localhost:5432/petshop?schema=public"
# Supabase: use a "Connection string" direta (porta 5432) aqui — usada só por `prisma migrate`.
DIRECT_URL="postgresql://usuario:senha@localhost:5432/petshop?schema=public"

# Servidor HTTP
PORT=3000
NODE_ENV=development

# Origem(ns) permitidas para CORS (separadas por vírgula). "*" libera qualquer origem.
# O frontend (frontend/) roda em http://localhost:8443 por padrão (ver frontend/vite.config.ts).
CORS_ORIGIN="http://localhost:8443"

# Autenticação
JWT_SECRET="troque-este-segredo-em-producao-com-32-caracteres-ou-mais"
JWT_EXPIRES_IN="1h"

# Bootstrap do usuário ADMIN inicial (usado por npm run prisma:seed)
ADMIN_NOME="Administrador"
ADMIN_EMAIL="admin@petshop.com"
ADMIN_SENHA="admin123"

# Bcrypt
BCRYPT_SALT_ROUNDS=10

# Logger
LOG_LEVEL=info
